# Canonical public URL. Used for metadata, sitemap and share links.
# Local: http://localhost:3000
# Production: https://tenderlens.civicailabs.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official Contracts Finder API host. Do not include a trailing slash.
CONTRACTS_FINDER_BASE_URL=https://www.contractsfinder.service.gov.uk

# Official Find a Tender OCDS API host. Do not include a trailing slash.
FIND_A_TENDER_BASE_URL=https://www.find-tender.service.gov.uk

# AI provider. none | openai | gemini
# The app works fully without AI using deterministic summaries from official fields.
AI_PROVIDER=none

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Development/testing only. Never enable on the production hostname.
# When true, local/preview builds may use marked fixture data if government APIs fail.
USE_TENDER_FIXTURES=false
