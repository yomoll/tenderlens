# Optional. If set, summaries and translations use this model.
# Without it, GovGuide still searches GOV.UK and writes an extractive plain-English answer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Canonical public URL. Locally you can set this to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://govguide.civicailabs.co.uk
